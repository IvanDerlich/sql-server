FROM mcr.microsoft.com/mssql/server:2022-latest

LABEL description="Microsoft SQL Server 2022 Developer Edition"

EXPOSE 1433

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD /bin/sh -c '/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "$MSSQL_SA_PASSWORD" -Q "SELECT 1" -b -C || exit 1'
